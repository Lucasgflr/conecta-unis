# Copie para .env e carregue as variaveis antes de executar.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES
DATABASE_URL=sqlite:///./data/conecta_unis.db
UPLOAD_DIR=./data/uploads
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Liga contas e vagas ficticias apenas em ambiente de desenvolvimento
DEMO_SEED=true
# SMTP opcional para validar e-mail e recuperar senha em ambiente real
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=false
SMTP_PASSWORD=false
SMTP_FROM=
SMTP_USE_TLS=true
